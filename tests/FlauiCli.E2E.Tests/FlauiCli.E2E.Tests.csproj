<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests that need a real interactive desktop:
    - DriverContractTests: verify every behaviour of the FlaUI adapter (the safety net for FlaUI upgrades)
    - CLI end-to-end tests (Calculator, WpfSample)
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FlauiCli.Core\FlauiCli.Core.csproj" />
    <ProjectReference Include="..\..\src\FlauiCli.Driver.FlaUI\FlauiCli.Driver.FlaUI.csproj" />
    <ProjectReference Include="..\..\src\FlauiCli\FlauiCli.csproj" />
    <!-- Only ensure WpfSample is built; its assembly is not referenced -->
    <ProjectReference Include="..\TestApps\WpfSample\WpfSample.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
