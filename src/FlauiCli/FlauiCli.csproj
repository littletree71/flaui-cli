<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Distribution: self-contained single-file executable (dotnet publish -p:PublishProfile=win-x64).
    Not a dotnet tool: the .NET SDK does not allow PackAsTool for projects whose target framework has a
    platform identifier (net10.0-windows, NETSDK1146), and FlaUI only ships Windows target frameworks.
    Not Native AOT: FlaUI.UIA3 uses built-in COM interop, which Native AOT does not support.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>FlauiCli</RootNamespace>
    <AssemblyName>flaui-cli</AssemblyName>
    <AssemblyTitle>flaui-cli - Windows desktop UI automation CLI</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>A playwright-cli style command-line tool for Windows desktop UI automation, built on FlaUI and designed for AI agents.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlauiCli.Core\FlauiCli.Core.csproj" />
    <ProjectReference Include="..\FlauiCli.Driver.FlaUI\FlauiCli.Driver.FlaUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped next to the executable: the agent skill used by install-skill, plus the license notices -->
    <None Include="..\..\skills\flaui-cli\SKILL.md" Link="skills\SKILL.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
