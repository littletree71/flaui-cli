<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained single-file executable (no .NET runtime needed on the target machine):
    dotnet publish src/FlauiCli -p:PublishProfile=win-x64
  Output: artifacts/flaui-cli/flaui-cli.exe plus LICENSE.txt, THIRD-PARTY-NOTICES.txt and skills/SKILL.md

  Compression and native-library self-extraction are deliberately disabled: compressed, self-extracting
  bundles look like packers to antivirus heuristics.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\flaui-cli\</PublishDir>
  </PropertyGroup>
</Project>
